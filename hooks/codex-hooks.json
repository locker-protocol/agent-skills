{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start.sh\" --host codex",
            "statusMessage": "Checking Locker Protocol Agentic readiness",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
